<Page x:Class="TriviaClient.SignUpPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:userControls="clr-namespace:TriviaClient.View.UserControls"
      xmlns:local="clr-namespace:TriviaClient"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SignUpPage">

    <Grid Background="LightBlue">
        <Grid.RowDefinitions>
            <RowDefinition Height="0.2*"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
    
        <Button Height="30" Width="80" HorizontalAlignment="Right" VerticalAlignment="Top" 
                Margin="0,25,25,0" Click="GoBack_Click" Content="Go Back" Background="red"
                FontFamily="Permanent Marker" FontSize="15">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <TextBlock Text="Sign Up!" FontSize="45" HorizontalAlignment="Center" VerticalAlignment="Center"
                FontFamily="Permanent Marker" Margin="30,0,30,0" />
        <Grid Grid.Row="1" Background="LightBlue">
            <Grid.RowDefinitions>
                <RowDefinition/> <!-- username -->
                <RowDefinition/> <!-- password -->
                <RowDefinition/> <!-- email -->
                <RowDefinition/> <!-- address -->
                <RowDefinition/> <!-- phone -->
                <RowDefinition/> <!-- birthdate -->
                <RowDefinition/> <!-- approve -->
            </Grid.RowDefinitions>

            <userControls:ClearableTextBox x:Name="UsernameTextBox" Grid.Row="0" Width="250" Height="40" PlaceHolder="username..."/>
            <userControls:ClearableTextBox x:Name="PasswordTextBox" Grid.Row="1" Width="250" Height="40" PlaceHolder="password..."/>
            <userControls:ClearableTextBox x:Name="EmailTextBox" Grid.Row="2" Width="250" Height="40" PlaceHolder="email (xx@gmail.com)..."/>
            <userControls:ClearableTextBox x:Name="AddressTextBox" Grid.Row="3" Width="250" Height="40" PlaceHolder="address (street, apt, city)..."/>
            <userControls:ClearableTextBox x:Name="PhoneTextBox" Grid.Row="4" Width="250" Height="40" PlaceHolder="phone (xx-7digits)..."/>

            <Border Background="White" Width="250" Height="40" Grid.Row="5">
                <DatePicker x:Name="BirthDatePicker" BorderThickness="0" VerticalContentAlignment="Center"
                FontFamily="Permanent Marker" FontSize="15" Foreground="DarkGray">
                </DatePicker>
            </Border>
            <Button Grid.Row="6" Content="SIGN UP"  Background="red" Width="125" Height="25"
                    FontFamily="Permanent Marker" FontSize="15" Click="GoToMenu_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Grid>
</Page>
