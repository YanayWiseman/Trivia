<Page x:Class="TriviaClient.SignUpPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="SignUpPage"
      Background="Transparent">

    <Page.Resources>

        <Style x:Key="SignupTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#FFFFF2C7"/>
            <Setter Property="CaretBrush" Value="#FFFFBF32"/>
            <Setter Property="Background" Value="#F20A060C"/>
            <Setter Property="BorderBrush" Value="#B8FFBF32"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SelectionBrush" Value="#FFC81D2A"/>
            <Setter Property="SelectionTextBrush" Value="White"/>

            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#FFFFD64A"/>
                    <Setter Property="Background" Value="#FF130B16"/>
                </Trigger>

                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#FFFFD64A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FFFFD36A"/>
            <Setter Property="Margin" Value="3,0,0,4"/>
        </Style>

        <Style x:Key="SignupDatePickerStyle" TargetType="DatePicker">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#FFFFF2C7"/>
            <Setter Property="Background" Value="#F20A060C"/>
            <Setter Property="BorderBrush" Value="#B8FFBF32"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>

            <Style.Resources>
                <Style TargetType="{x:Type DatePickerTextBox}">
                    <Setter Property="FontFamily" Value="Consolas"/>
                    <Setter Property="FontSize" Value="15"/>
                    <Setter Property="Foreground" Value="#FFFFF2C7"/>
                    <Setter Property="CaretBrush" Value="#FFFFBF32"/>
                    <Setter Property="Background" Value="#F20A060C"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="5,0"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="SelectionBrush" Value="#FFC81D2A"/>
                    <Setter Property="SelectionTextBrush" Value="White"/>
                </Style>
            </Style.Resources>

            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#FFFFD64A"/>
                    <Setter Property="Background" Value="#FF130B16"/>
                </Trigger>

                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#FFFFD64A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CyberCalendarDayStyle" TargetType="{x:Type CalendarDayButton}">
            <Setter Property="Foreground" Value="#FFFFF2C7"/>
            <Setter Property="Background" Value="#FF24151F"/>
            <Setter Property="BorderBrush" Value="#553F292D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CalendarDayButton}">
                        <Border x:Name="DayBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="2"
                        Margin="1">

                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DayBorder"
                                Property="Background"
                                Value="#FF751923"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="DayBorder"
                                Property="Background"
                                Value="#FFC81D2A"/>
                                <Setter TargetName="DayBorder"
                                Property="BorderBrush"
                                Value="#FFFFBF32"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>

                            <Trigger Property="IsToday" Value="True">
                                <Setter TargetName="DayBorder"
                                Property="BorderBrush"
                                Value="#FFFFBF32"/>
                                <Setter TargetName="DayBorder"
                                Property="BorderThickness"
                                Value="2"/>
                            </Trigger>

                            <Trigger Property="IsBlackedOut" Value="True">
                                <Setter TargetName="DayBorder"
                                Property="Background"
                                Value="#FF130D14"/>
                                <Setter Property="Foreground"
                                Value="#FF665C61"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CyberCalendarButtonStyle"
       TargetType="{x:Type CalendarButton}">

            <Setter Property="Foreground" Value="#FFFFF2C7"/>
            <Setter Property="Background" Value="#FF35151B"/>
            <Setter Property="BorderBrush" Value="#66FFBF32"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CalendarButton}">
                        <Border x:Name="ButtonBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="3"
                        Margin="2">

                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                Property="Background"
                                Value="#FF751923"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CyberCalendarItemStyle"
       TargetType="{x:Type CalendarItem}">

            <Setter Property="Background" Value="#FF160E17"/>
            <Setter Property="Foreground" Value="#FFFFF2C7"/>
            <Setter Property="BorderBrush" Value="#FFFFBF32"/>
            <Setter Property="BorderThickness" Value="1.5"/>

            <Style.Resources>
                <Style TargetType="{x:Type CalendarDayButton}"
               BasedOn="{StaticResource CyberCalendarDayStyle}"/>

                <Style TargetType="{x:Type CalendarButton}"
               BasedOn="{StaticResource CyberCalendarButtonStyle}"/>
            </Style.Resources>
        </Style>

        <Style x:Key="CyberCalendarStyle"
       TargetType="{x:Type Calendar}">

            <Setter Property="Background" Value="#FF160E17"/>
            <Setter Property="Foreground" Value="#FFFFF2C7"/>
            <Setter Property="BorderBrush" Value="#FFFFBF32"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontFamily" Value="Consolas"/>

            <Style.Resources>
                <Style TargetType="{x:Type CalendarItem}"
               BasedOn="{StaticResource CyberCalendarItemStyle}"/>

                <Style TargetType="{x:Type CalendarDayButton}"
               BasedOn="{StaticResource CyberCalendarDayStyle}"/>

                <Style TargetType="{x:Type CalendarButton}"
               BasedOn="{StaticResource CyberCalendarButtonStyle}"/>
            </Style.Resources>
        </Style>

    </Page.Resources>

    <Grid Margin="24">

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <Border Width="480"
                    Padding="36,22"
                    Margin="0,38,0,14"
                    HorizontalAlignment="Center"
                    Background="#E8160E17"
                    BorderBrush="#C8FFBF32"
                    BorderThickness="1.5"
                    CornerRadius="10">

                <StackPanel>

                    <TextBlock Text="CREATE IDENTITY"
                               FontSize="31"
                               FontWeight="Black"
                               Foreground="#FFFFF2C7"
                               TextAlignment="Center"/>

                    <TextBlock Text="NEW OPERATOR REGISTRATION"
                               FontFamily="Consolas"
                               FontSize="12"
                               Foreground="#FFFFBF32"
                               TextAlignment="Center"
                               Margin="0,4,0,16"/>

                    <TextBlock Text="USERNAME"
                               Style="{StaticResource FieldLabelStyle}"/>

                    <TextBox x:Name="UsernameTextBox"
                             Style="{StaticResource SignupTextBoxStyle}"
                             Margin="0,0,0,8"/>

                    <TextBlock Text="PASSWORD"
                               Style="{StaticResource FieldLabelStyle}"/>

                    <TextBox x:Name="PasswordTextBox"
                             Style="{StaticResource SignupTextBoxStyle}"
                             Margin="0,0,0,8"/>

                    <TextBlock Text="EMAIL"
                               Style="{StaticResource FieldLabelStyle}"/>

                    <TextBox x:Name="EmailTextBox"
                             Style="{StaticResource SignupTextBoxStyle}"
                             Margin="0,0,0,8"/>

                    <TextBlock Text="ADDRESS"
                               Style="{StaticResource FieldLabelStyle}"/>

                    <TextBox x:Name="AddressTextBox"
                             Style="{StaticResource SignupTextBoxStyle}"
                             Margin="0,0,0,8"/>

                    <TextBlock Text="PHONE"
                               Style="{StaticResource FieldLabelStyle}"/>

                    <TextBox x:Name="PhoneTextBox"
                             Style="{StaticResource SignupTextBoxStyle}"
                             Margin="0,0,0,8"/>

                    <TextBlock Text="BIRTH DATE"
                               Style="{StaticResource FieldLabelStyle}"/>

                    <DatePicker x:Name="BirthDatePicker"
                        Style="{StaticResource SignupDatePickerStyle}"
                        CalendarStyle="{StaticResource CyberCalendarStyle}"
                        SelectedDateFormat="Short"
                        Margin="0,0,0,15"/>

                    <Button Content="SIGN UP"
                            Height="44"
                            FontSize="16"
                            Click="GoToMenu_Click"/>

                </StackPanel>
            </Border>
        </ScrollViewer>

        <Button Content="BACK"
                Width="105"
                Height="40"
                Padding="8,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Click="GoBack_Click"/>

    </Grid>
</Page>