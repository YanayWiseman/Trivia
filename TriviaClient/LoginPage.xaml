<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:TriviaClient" x:Class="TriviaClient.LoginPage" mc:Ignorable="d" d:DesignHeight="550" d:DesignWidth="800" Title="LoginPage" Background="Transparent">

    <Grid Background="Transparent">

        <Button Height="40" Width="110" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,25,25,0" Click="GoBack_Click">
            Go Back
        </Button>

        <Border Width="330" Padding="30" Background="#DC160E17" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#B8FFBF32" BorderThickness="1.5">

            <StackPanel>

                <TextBlock Text="Login" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                <TextBlock Text="Username" FontSize="14" Margin="0,0,0,5"/>

                <TextBox x:Name="UsernameTextBox" Height="40" FontSize="16" Margin="0,0,0,15"/>

                <TextBlock Text="Password" FontSize="14" Margin="0,0,0,5"/>

                <PasswordBox x:Name="PasswordBox" Height="40" FontSize="16" Margin="0,0,0,25"/>

                <Button Content="Login" Height="40" FontSize="16" Click="LoginButton_Click"/>

            </StackPanel>
        </Border>
    </Grid>
</Page>
