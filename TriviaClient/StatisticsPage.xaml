<Page x:Class="TriviaClient.StatisticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TriviaClient"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="StatisticsPage">

    <Grid Background="LightBlue">
        <Grid.RowDefinitions>
            <RowDefinition Height="0.2*"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        
        <Button Height="30" Width="80" HorizontalAlignment="Right" VerticalAlignment="Top" 
                Margin="0,25,25,0" Click="GoBack_Click" Content="Go Back" Background="red"
                FontFamily="Permanent Marker" FontSize="15"/>

        <TextBlock Text="statistics" FontSize="45" HorizontalAlignment="Center" VerticalAlignment="Center"
                FontFamily="Permanent Marker" Margin="30,0,30,0" />

        <Grid Grid.Row="1" Background="LightBlue">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Button Width="300" Height="75" FontSize="30" Background="red" FontFamily="Permanent Marker" Content="My Statistics" />
            <Button Grid.Row="1" Width="300" Height="75" FontSize="30" Background="red" FontFamily="Permanent Marker" Content="Best Players" />
        </Grid>
    </Grid>
</Page>
