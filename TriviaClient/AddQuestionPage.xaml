<Page x:Class="TriviaClient.AddQuestionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TriviaClient"
      xmlns:userControls="clr-namespace:TriviaClient.View.UserControls"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddQuestionPage">

    <Grid Background="#FF4100">
        <Border Grid.Column="1" Width="520" Padding="25" Background="Orange" CornerRadius="12" HorizontalAlignment="Center"
                VerticalAlignment="Center">
            
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.65*"/>
                    <ColumnDefinition Width="0.35*"/>
                </Grid.ColumnDefinitions>


                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="ADD QUESTION" FontSize="28" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,20" FontFamily="Permanent Marker"/>
                
                <ScrollViewer Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Grid.Row="1" Grid.Column="0">

                        <TextBlock Text="Question" FontFamily="Permanent Marker"/>
                        <userControls:ClearableTextBox x:Name="QuestionBox" Height="40" Margin="0,0,0,15" PlaceHolder="Enter question..." />

                        <TextBlock Text="Answers" FontFamily="Permanent Marker"/>

                        <userControls:ClearableTextBox x:Name="Answer1Box" Height="40" Margin="0,0,0,8" PlaceHolder="Answer 1" />

                        <userControls:ClearableTextBox x:Name="Answer2Box" Height="40" Margin="0,0,0,8" PlaceHolder="Answer 2" />

                        <userControls:ClearableTextBox x:Name="Answer3Box" Height="40" Margin="0,0,0,8" PlaceHolder="Answer 3" />

                        <userControls:ClearableTextBox x:Name="Answer4Box" Height="40" Margin="0,0,0,12" PlaceHolder="Answer 4" />


                        <TextBlock Text="Correct Answer Index (1–4)" FontFamily="Permanent Marker" Margin="0,0,0,5"/>

                        <TextBox x:Name="CorrectIndexBox" Height="35" FontSize="16" FontFamily="Permanent Marker"/>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="1" Grid.Column="1" Margin="15,40,0,0">

                    <TextBlock Text="Image (optional)" FontFamily="Permanent Marker" FontSize="18" HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>

                    <Button x:Name="PickImageButton" Content="Pick Image" Height="35" Background="Red"
                            FontFamily="Permanent Marker" Margin="0,0,0,10" Click="PickImage_Click">

                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                            CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <TextBlock x:Name="ImageStatusText" Text="No image selected" FontFamily="Permanent Marker" FontSize="12"
                               Foreground="DarkRed" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                </StackPanel>


                <Button Grid.Row="2" Grid.ColumnSpan="2" Content="Submit Question" Height="40" Width="200" Margin="0,20,0,0"
                        HorizontalAlignment="Center" Background="Red" FontFamily="Permanent Marker" Click="SubmitQuestion_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">

                            <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="5">

                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>
