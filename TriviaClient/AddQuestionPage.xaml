<Page x:Class="TriviaClient.AddQuestionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TriviaClient"
      xmlns:userControls="clr-namespace:TriviaClient.View.UserControls"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddQuestionPage">

    <Grid Background="#FF4100">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.2*"/>
            <ColumnDefinition Width="0.6*"/>
            <ColumnDefinition Width="0.2*"/>
        </Grid.ColumnDefinitions>

        <Button Content="Go Back" Grid.Column="2" Height="30" Width="90" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,25,25,0" Background="Orange" FontFamily="Permanent Marker" Click="GoBack_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="10" >
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>
        <Border Width="420" Grid.Column="1" Padding="25" Background="Orange" CornerRadius="12" HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>

                <TextBlock Text="Add Question" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20" FontFamily="Permanent Marker"/>

                <TextBlock Text="Question" FontFamily="Permanent Marker"/>
                <userControls:ClearableTextBox x:Name="QuestionBox" Height="40" Margin="0,0,0,15" PlaceHolder="Enter question..." />

                <TextBlock Text="Answers" FontFamily="Permanent Marker"/>
                
                <userControls:ClearableTextBox x:Name="Answer1Box" Height="40" Margin="0,0,0,10" PlaceHolder="Answer 1" />
                <userControls:ClearableTextBox x:Name="Answer2Box" Height="40" Margin="0,0,0,10" PlaceHolder="Answer 2" />
                <userControls:ClearableTextBox x:Name="Answer3Box" Height="40" Margin="0,0,0,10" PlaceHolder="Answer 3" />
                <userControls:ClearableTextBox x:Name="Answer4Box" Height="40" Margin="0,0,0,10" PlaceHolder="Answer 4" />

                <TextBlock Text="Correct Answer Index (1–4)" FontFamily="Permanent Marker" Margin="0,0,0,5"/>

                <TextBox x:Name="CorrectIndexBox" Height="35" FontSize="16" FontFamily="Permanent Marker" Margin="0,0,0,20"/>

            </StackPanel>
        </Border>
        <Button Content="Submit Question" Height="40" Margin="25,0,0,0" Background="Orange" FontFamily="Permanent Marker" Click="Submit_Click">
            <Button.Template>
            <ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}" CornerRadius="10">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Page>
