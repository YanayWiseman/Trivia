<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="TriviaClient.OneVsOneQueuePage" Title="OneVsOneQueuePage" Background="Transparent">

    <Grid Background="Transparent">
        <Border Width="420" Height="280" Padding="30" Background="#DC160E17" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#B8FFBF32" BorderThickness="1.5">

            <StackPanel VerticalAlignment="Center">

                <TextBlock Text="Searching for 1v1 Match..." FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                <TextBlock x:Name="statusTextBlock" Text="Waiting for opponent..." FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                <ProgressBar Height="18" IsIndeterminate="True" Margin="0,0,0,30"/>

                <Button Content="Cancel" Height="45" Width="180" FontSize="18" HorizontalAlignment="Center" Click="Cancel_Click"/>

            </StackPanel>
        </Border>
    </Grid>
</Page>
