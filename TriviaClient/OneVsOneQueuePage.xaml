<Page x:Class="TriviaClient.OneVsOneQueuePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="OneVsOneQueuePage">

    <Grid Background="#FF4100">
        <Border Width="420"
                Height="280"
                Padding="30"
                Background="Orange"
                CornerRadius="12"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel VerticalAlignment="Center">

                <TextBlock Text="Searching for 1v1 Match..."
                           FontSize="28"
                           FontWeight="Bold"
                           FontFamily="Permanent Marker"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,25"/>

                <TextBlock x:Name="statusTextBlock"
                           Text="Waiting for opponent..."
                           FontSize="20"
                           FontFamily="Permanent Marker"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,25"/>

                <ProgressBar Height="18"
                             IsIndeterminate="True"
                             Margin="0,0,0,30"/>

                <Button Content="Cancel"
                        Height="45"
                        Width="180"
                        FontSize="18"
                        FontFamily="Permanent Marker"
                        HorizontalAlignment="Center"
                        Click="Cancel_Click"/>

            </StackPanel>
        </Border>
    </Grid>
</Page>