<Page x:Class="TriviaClient.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TriviaClient"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage">

    <Grid Background="LightBlue">
        <Grid.RowDefinitions>
            <RowDefinition Height="0.30*"/>
            <!-- Title -->
            <RowDefinition Height="0.30*"/>
            <!-- Log In -->
            <RowDefinition Height="0.10*"/>
            <!-- or -->
            <RowDefinition Height="0.30*"/>
            <!-- sign up -->
        </Grid.RowDefinitions>


        <TextBlock FontSize="45" HorizontalAlignment="Center" VerticalAlignment="Center"
                FontFamily="Permanent Marker" Margin="30,0,30,0">
         Welcome To Machshilim Trivia!
        </TextBlock>

        <Button Grid.Row="1" Margin="50,30,50,50" Width="150" Content="Log In" FontSize="25"
             HorizontalAlignment="Center" VerticalAlignment="Center"
             FontFamily="Permanent Marker" Background="red"
             Click="LoginButton_Click">
        </Button>

        <TextBlock Grid.Row="2" FontSize="35" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Permanent Marker">
         OR
        </TextBlock>

        <Button Grid.Row="3" Margin="50,30,50,50" Width="150" HorizontalAlignment="Center" VerticalAlignment="Center" Content="Sign Up" FontSize="25"
             FontFamily="Permanent Marker" Background="red" Click="SignUpButton_Click">
        </Button>
    </Grid>
</Page>
