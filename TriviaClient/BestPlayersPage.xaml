<Page x:Class="TriviaClient.BestPlayersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TriviaClient"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="BestPlayersPage">

    <Grid Background="LightBlue">
        <Grid.RowDefinitions>
            <RowDefinition Height="0.4*"/>
            <RowDefinition Height="0.1*"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Button Height="30" Width="80" HorizontalAlignment="Right" VerticalAlignment="Top" 
                Margin="0,25,25,0" Click="GoBack_Click" Content="Go Back" Background="red"
                FontFamily="Permanent Marker" FontSize="15">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <TextBlock Text="Best Players" FontSize="45" HorizontalAlignment="Center" VerticalAlignment="Center"
                FontFamily="Permanent Marker" Margin="30,0,30,0" />
        
        <TextBlock Grid.Row="1" Text="Top 3 players scores" HorizontalAlignment="Center" FontWeight="bold"
                   VerticalAlignment="Center" FontFamily="Permanent Marker" FontSize="30"/>

        <ListBox x:Name="BestPlayersListBox"
         Width="300"
         Height="250"
         FontFamily="Permanent Marker"
         FontSize="18" Margin="250,25,250,25" Grid.Row="2"/>
    </Grid>
</Page>
