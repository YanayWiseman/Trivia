<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" x:Class="TriviaClient.GamePage" mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800" Title="GamePage" Background="Transparent">
    <Grid Background="Transparent">

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="Transparent">

            <TextBlock x:Name="questionNumberTextBlock" Text="Question 1 / 99" FontSize="22" Foreground="#FFFFD27A" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="30,0,0,0"/>

            <TextBlock x:Name="timerTextBlock" Text="67" FontSize="36" FontWeight="Bold" Foreground="#FFFFD27A" VerticalAlignment="Center" HorizontalAlignment="Center"/>

            <TextBlock x:Name="scoreTextBlock" Text="Correct Answers: 0" FontSize="22" Foreground="#FFFFD27A" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,30,0"/>

        </Grid>

        <Border Grid.Row="1" Background="#DC160E17" CornerRadius="16" Padding="15" Margin="60,25,60,15" VerticalAlignment="Top" BorderBrush="#B8FFBF32" BorderThickness="1.5">
            <StackPanel>

                <Image x:Name="questionImage" MaxHeight="160" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,8" Visibility="Collapsed"/>

                <TextBlock x:Name="questionTextBlock" Text="Question?" FontSize="28" FontWeight="Bold" Foreground="#FFFFD27A" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="60,10,60,35">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <Button x:Name="answerButton1" Grid.Row="0" Grid.Column="0" Margin="0,0,12,12" FontSize="22" FontWeight="Bold" Background="#FFE52B35" Foreground="White" BorderBrush="#FFFFE9AA" BorderThickness="1.5" Click="AnswerButton_Click">

                <TextBlock x:Name="answerTextBlock1" Text="Answer 1" TextWrapping="Wrap" TextAlignment="Center"/>
            </Button>


            <Button x:Name="answerButton2" Grid.Row="0" Grid.Column="1" Margin="12,0,0,12" FontSize="22" FontWeight="Bold" Background="#FFFFBF32" Foreground="#FF16080B" BorderBrush="#FFFFE9AA" BorderThickness="1.5" Click="AnswerButton_Click">

                <TextBlock x:Name="answerTextBlock2" Text="Answer 2" TextWrapping="Wrap" TextAlignment="Center"/>
            </Button>


            <Button x:Name="answerButton3" Grid.Row="1" Grid.Column="0" Margin="0,12,12,0" FontSize="22" FontWeight="Bold" Background="#FFE52B35" Foreground="White" BorderBrush="#FFFFE9AA" BorderThickness="1.5" Click="AnswerButton_Click">

                <TextBlock x:Name="answerTextBlock3" Text="Answer 3" TextWrapping="Wrap" TextAlignment="Center"/>
            </Button>


            <Button x:Name="answerButton4" Grid.Row="1" Grid.Column="1" Margin="12,12,0,0" FontSize="22" FontWeight="Bold" Background="#FFFFBF32" Foreground="#FF16080B" BorderBrush="#FFFFE9AA" BorderThickness="1.5" Click="AnswerButton_Click">

                <TextBlock x:Name="answerTextBlock4" Text="Answer 4" TextWrapping="Wrap" TextAlignment="Center"/>
            </Button>

        </Grid>
        <Button x:Name="leaveButton" Content="Leave" Width="24" Height="24" FontSize="12" FontWeight="Bold" Grid.Row="2" HorizontalAlignment="Right" 
                VerticalAlignment="Bottom" Margin="0,0,15,10" Background="#FFE52B35" Foreground="White" 
                BorderBrush="#FFFFE9AA" BorderThickness="1.5" Click="LeaveGameButton_Click">

            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="12"/>
                </Style>
            </Button.Resources>
        </Button>
    </Grid>
</Page>