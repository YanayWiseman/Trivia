<Page x:Class="TriviaClient.GamePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="450"
      d:DesignWidth="800"
      Title="GamePage">

    <Grid Background="#FF4100">

        <Grid Height="70"
              VerticalAlignment="Top"
              Background="#E63A00">

            <TextBlock x:Name="questionNumberTextBlock"
                       Text="Question 1 / 99"
                       FontSize="22"
                       FontFamily="Permanent Marker"
                       Foreground="Black"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"
                       Margin="30,0,0,0"/>

            <TextBlock x:Name="timerTextBlock"
                       Text="67"
                       FontSize="36"
                       FontWeight="Bold"
                       FontFamily="Permanent Marker"
                       Foreground="Black"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>

            <TextBlock x:Name="scoreTextBlock"
                       Text="Score: 0"
                       FontSize="22"
                       FontFamily="Permanent Marker"
                       Foreground="Black"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Margin="0,0,30,0"/>

        </Grid>


        <Border Background="Orange"
                CornerRadius="16"
                Padding="25"
                Margin="60,95,60,0"
                Height="135"
                VerticalAlignment="Top">

            <TextBlock x:Name="questionTextBlock"
                       Text="Question?"
                       FontSize="28"
                       FontWeight="Bold"
                       FontFamily="Permanent Marker"
                       Foreground="Black"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

        </Border>


        <Grid Margin="60,255,60,35">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <Button x:Name="answerButton1"
        Grid.Row="0"
        Grid.Column="0"
        Margin="0,0,12,12"
        FontSize="22"
        FontFamily="Permanent Marker"
        FontWeight="Bold"
        Background="#FB8C00"
        Foreground="Black"
        BorderBrush="Black"
        BorderThickness="3"
        Click="AnswerButton_Click">

                <TextBlock Text="Answer 1"
               TextWrapping="Wrap"
               TextAlignment="Center"/>
            </Button>


            <Button x:Name="answerButton2"
        Grid.Row="0"
        Grid.Column="1"
        Margin="12,0,0,12"
        FontSize="22"
        FontFamily="Permanent Marker"
        FontWeight="Bold"
        Background="#FDD835"
        Foreground="Black"
        BorderBrush="Black"
        BorderThickness="3"
        Click="AnswerButton_Click">

                <TextBlock Text="Answer 2"
               TextWrapping="Wrap"
               TextAlignment="Center"/>
            </Button>


            <Button x:Name="answerButton3"
        Grid.Row="1"
        Grid.Column="0"
        Margin="0,12,12,0"
        FontSize="22"
        FontFamily="Permanent Marker"
        FontWeight="Bold"
        Background="#E53935"
        Foreground="Black"
        BorderBrush="Black"
        BorderThickness="3"
        Click="AnswerButton_Click">

                <TextBlock Text="Answer 3"
               TextWrapping="Wrap"
               TextAlignment="Center"/>
            </Button>


            <Button x:Name="answerButton4"
        Grid.Row="1"
        Grid.Column="1"
        Margin="12,12,0,0"
        FontSize="22"
        FontFamily="Permanent Marker"
        FontWeight="Bold"
        Background="#8D2C00"
        Foreground="Black"
        BorderBrush="Black"
        BorderThickness="3"
        Click="AnswerButton_Click">

                <TextBlock Text="Answer 4"
               TextWrapping="Wrap"
               TextAlignment="Center"/>
            </Button>

        </Grid>

    </Grid>
</Page>