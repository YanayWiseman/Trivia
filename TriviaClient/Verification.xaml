<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" x:Class="TriviaClient.VerificationPage" mc:Ignorable="d" d:DesignHeight="550" d:DesignWidth="800" Title="VerificationPage" Background="Transparent">

    <Grid Background="Transparent">

        <Button Height="40" Width="110" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,25,25,0" Click="GoBack_Click">
            Go Back
        </Button>

        <Border Width="330" Padding="30" Background="#DC160E17" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#B8FFBF32" BorderThickness="1.5">

            <StackPanel>

                <TextBlock Text="Email Verification" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,25"/>

                <TextBlock Text="A verification code was sent to your email." FontSize="14" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,20"/>

                <TextBlock Text="Verification Code" FontSize="14" Margin="0,0,0,5"/>

                <TextBox x:Name="CodeTextBox" Height="40" FontSize="16" MaxLength="10" Margin="0,0,0,20"/>

                <Button x:Name="VerifyButton" Content="Verify" Height="40" FontSize="16" Click="VerifyButton_Click"/>

                <Button x:Name="ResendButton" Content="Resend Code" Height="40" FontSize="14" Margin="0,10,0,0" Click="ResendButton_Click"/>

                <TextBlock x:Name="StatusTextBlock" FontSize="14" TextAlignment="Center" TextWrapping="Wrap" Margin="0,15,0,0"/>

            </StackPanel>
        </Border>
    </Grid>
</Page>
