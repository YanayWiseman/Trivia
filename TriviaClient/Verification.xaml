<Page x:Class="TriviaClient.VerificationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="550"
      d:DesignWidth="800"
      Title="VerificationPage">

    <Grid Background="#FF4100">

        <Button Height="30"
                Width="80"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,25,25,0"
                Background="Red"
                FontFamily="Permanent Marker"
                Click="GoBack_Click">
            Go Back
        </Button>

        <Border Width="330"
                Padding="30"
                Background="Orange"
                CornerRadius="12"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>

                <TextBlock Text="Email Verification"
                           FontSize="28"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,0,0,25"
                           FontFamily="Permanent Marker"/>

                <TextBlock Text="A verification code was sent to your email."
                           FontSize="14"
                           FontFamily="Permanent Marker"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,0,20"/>

                <TextBlock Text="Verification Code"
                           FontSize="14"
                           FontFamily="Permanent Marker"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="CodeTextBox"
                         Height="35"
                         FontSize="16"
                         FontFamily="Permanent Marker"
                         MaxLength="10"
                         Margin="0,0,0,20"/>

                <Button x:Name="VerifyButton"
                        Content="Verify"
                        Height="40"
                        FontSize="16"
                        FontFamily="Permanent Marker"
                        Click="VerifyButton_Click"/>

                <Button x:Name="ResendButton"
                        Content="Resend Code"
                        Height="35"
                        FontSize="14"
                        FontFamily="Permanent Marker"
                        Margin="0,10,0,0"
                        Click="ResendButton_Click"/>

                <TextBlock x:Name="StatusTextBlock"
                           FontSize="14"
                           FontFamily="Permanent Marker"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,15,0,0"/>

            </StackPanel>
        </Border>
    </Grid>
</Page>