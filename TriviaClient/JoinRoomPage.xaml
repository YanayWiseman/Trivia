<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" x:Class="TriviaClient.JoinRoomPage" mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800" Title="JoinRoomPage" Background="Transparent">

    <Grid Background="Transparent">

        <Button Height="40" Width="110" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,25,25,0" Click="GoBack_Click" Content="Go Back" FontSize="15">
            </Button>

        <Border Width="420" Padding="30" Background="#DC160E17" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#B8FFBF32" BorderThickness="1.5">
            <StackPanel>

                <TextBlock Text="Join Room" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                <TextBlock Text="Available Rooms" FontSize="16" Margin="0,0,0,8"/>

                <ListBox x:Name="RoomsListBox" Height="180" FontSize="16" Margin="0,0,0,20"/>

                <Button Content="JOIN ROOM" Height="40" FontSize="17" Click="JoinRoom_Click">
                    </Button>

            </StackPanel>
        </Border>

    </Grid>
</Page>
