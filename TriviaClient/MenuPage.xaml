<Page x:Class="TriviaClient.MenuPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="450"
      d:DesignWidth="800"
      Title="MenuPage">

    <Grid Background="#FF4100">

        <Border Width="360"
                Padding="30"
                Background="Orange"
                CornerRadius="12"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>

                <TextBlock Text="Machsilim Trivia"
                           FontSize="34"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           FontFamily="Permanent Marker"
                           Margin="0,0,0,35"/>

                <Button Content="Create Room"
                        Height="45"
                        FontSize="18"
                        FontFamily="Permanent Marker"
                        Margin="0,0,0,15"
                        Click="CreateRoom_Click"/>

                <Button Content="Join Room"
                        Height="45"
                        FontSize="18"
                        FontFamily="Permanent Marker"
                        Margin="0,0,0,15"
                        Click="JoinRoom_Click"/>

                <Button Content="Statistics"
                        Height="45"
                        FontSize="18"
                        FontFamily="Permanent Marker"
                        Margin="0,0,0,15"
                        Click="Statistics_Click"/>

                <Button Content="Logout"
                Height="45"
                FontSize="18"
                FontFamily="Permanent Marker"
                Margin="0,0,0,15"
                Click="Logout_Click"/>
                
                <Button Content="Exit"
                        Height="45"
                        FontSize="18"
                        FontFamily="Permanent Marker"
                        Click="Exit_Click"/>

            </StackPanel>
        </Border>
    </Grid>
</Page>