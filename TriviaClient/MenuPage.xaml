<Page x:Class="TriviaClient.MenuPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="MenuPage" Background="Transparent">
 <Grid Margin="38">
  <TextBlock x:Name="userNameTextBlock" FontFamily="Consolas" FontSize="16" Foreground="#FFFFBF32" HorizontalAlignment="Left" VerticalAlignment="Top"/>
  <Border Width="520" Padding="42,34" Background="#DF160E17" BorderBrush="#C8FFBF32" BorderThickness="1.5" CornerRadius="10" HorizontalAlignment="Center" VerticalAlignment="Center">
   <StackPanel>
    <TextBlock Text="COMMAND CONSOLE" FontSize="34" FontWeight="Black" TextAlignment="Center"/>
    <TextBlock Text="MACHSHILIM TRIVIA NETWORK" FontFamily="Consolas" FontSize="12" Foreground="#FFFFBF32" TextAlignment="Center" Margin="0,6,0,28"/>
    <Button Content="CREATE ROOM" Height="46" Margin="0,0,0,10" Click="CreateRoom_Click"/>
    <Button Content="JOIN ROOM" Height="46" Margin="0,0,0,10" Click="JoinRoom_Click"/>
    <Button Content="ONE VS ONE" Height="46" Margin="0,0,0,10" Click="OneVsOne_Click"/>
    <Button Content="STATISTICS" Height="46" Margin="0,0,0,10" Click="Statistics_Click"/>
    <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="LOGOUT" Height="42" Margin="0,0,5,0" Click="Logout_Click"/><Button Grid.Column="1" Content="EXIT" Height="42" Margin="5,0,0,0" Click="Exit_Click"/></Grid>
   </StackPanel>
  </Border>
 </Grid>
</Page>