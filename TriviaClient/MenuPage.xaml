<Page x:Class="TriviaClient.MenuPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="450"
      d:DesignWidth="800"
      Title="MenuPage">

    <Grid Background="#FF4100">
        <TextBlock x:Name="userNameTextBlock" FontSize="24" Foreground="Black" Margin="30"
               HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Permanent Marker"/>
        <Border Width="370"
        Padding="24"
        Background="Orange"
        CornerRadius="12"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Height="430">

            <StackPanel>

                <TextBlock Text="Machshilim Trivia"
                   FontSize="30"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   FontFamily="Permanent Marker"
                   Margin="0,0,0,24"/>

                <Button Content="Create Room"
                Height="40"
                FontSize="17"
                FontFamily="Permanent Marker"
                Margin="0,0,0,10"
                Click="CreateRoom_Click"/>

                <Button Content="Join Room"
                Height="40"
                FontSize="17"
                FontFamily="Permanent Marker"
                Margin="0,0,0,10"
                Click="JoinRoom_Click"/>

                <Button Content="One VS One"
                Height="40"
                FontSize="17"
                FontFamily="Permanent Marker"
                Margin="0,0,0,10"
                Click="OneVsOne_Click"/>

                <Button Content="Statistics"
                Height="40"
                FontSize="17"
                FontFamily="Permanent Marker"
                Margin="0,0,0,10"
                Click="Statistics_Click"/>

                <Button Content="Logout"
                Height="40"
                FontSize="17"
                FontFamily="Permanent Marker"
                Margin="0,0,0,10"
                Click="Logout_Click"/>

                <Button Content="Exit"
                Height="40"
                FontSize="17"
                FontFamily="Permanent Marker"
                Click="Exit_Click"/>

            </StackPanel>
        </Border>
    </Grid>
</Page>
