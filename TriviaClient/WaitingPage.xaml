<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:TriviaClient" x:Class="TriviaClient.WaitingPage" mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800" Title="WaitingPage" Background="Transparent">

    <Grid Background="Transparent">

        <Button x:Name="LeaveRoomButton" Height="40" Width="115" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,25,25,0" Click="LeaveRoom_Click" Content="Leave Room" FontSize="15">
            </Button>

        <Button x:Name="addQuestionButton" Height="40" Width="195" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="15,25,0,0" Click="AddQuestion_Click" Content="ADD NEW QUESTION" FontSize="15">
            </Button>

        <Border Width="420" Padding="30" Background="#DC160E17" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#B8FFBF32" BorderThickness="1.5">
            <StackPanel>

                <TextBlock x:Name="roomNameTxt" Text="Room name" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                <TextBlock Text="Players" FontSize="16" Margin="0,0,0,8"/>

                <ListBox x:Name="PlayerBox" Height="180" FontSize="16" Margin="0,0,0,20"/>

                <Button x:Name="StartGameButton" Content="START GAME" Height="40" FontSize="17" Click="StartGame_Click">
                    </Button>
                <Button x:Name="CloseRoomButton" Content="CLOSE ROOM" Margin="0,5,0,0" Height="40" FontSize="17" Click="CloseRoom_Click">
                    </Button>


            </StackPanel>
        </Border>

    </Grid>
</Page>
