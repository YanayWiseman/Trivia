<Page x:Class="TriviaClient.WaitingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TriviaClient"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="WaitingPage">

    <Grid Background="#FF4100">

        <Button Height="30" Width="96" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,25,25,0" Click="LeaveRoom_Click" Content="Leave Room" Background="Red" FontFamily="Permanent Marker" FontSize="15">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <Border Width="420" Padding="30" Background="Orange" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>

                <TextBlock x:Name="roomName" Text="Room name" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center" FontFamily="Permanent Marker" Margin="0,0,0,25"/>

                <TextBlock Text="Players" FontSize="16" FontFamily="Permanent Marker" Margin="0,0,0,8"/>

                <ListBox x:Name="PlayerBox" Height="180" FontSize="16" FontFamily="Permanent Marker" Margin="0,0,0,20"/>

                <Button Content="START GAME" Height="40" FontSize="17" FontFamily="Permanent Marker" Background="Red" Click="StartGame_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="CloseRoomButton" Content="CLOSE ROOM" Margin="0,5,0,0" Height="40" FontSize="17" FontFamily="Permanent Marker" Background="Red" Click="CloseRoom_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>


            </StackPanel>
        </Border>

    </Grid>
</Page>
