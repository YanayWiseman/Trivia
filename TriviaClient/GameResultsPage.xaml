<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:TriviaClient" x:Class="TriviaClient.GameResultsPage" mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800" Title="GameResultsPage" Background="Transparent">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="0.2*"/>
            <RowDefinition/>
            <RowDefinition Height="0.2*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Game Results" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="45"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="20,10">
            <Border Background="#DC160E17" BorderBrush="#B8FFBF32" BorderThickness="1.5" CornerRadius="15" Width="540" HorizontalAlignment="Center" Padding="15">
                <ItemsControl x:Name="ResultsList" ItemsSource="{Binding leaderboard}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#DC160E17" BorderBrush="#B8FFBF32" BorderThickness="1.5" CornerRadius="10" Padding="20,12" Margin="0,6" Width="500">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <TextBlock Text="#" FontSize="22" Foreground="#FFFFD27A"/>
                                        <TextBlock Text="{Binding Rank}" FontSize="24" FontWeight="Bold" Foreground="#FFFFD27A"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" Text="{Binding PlayerName}" FontSize="22" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding CorrectAnswers}" FontSize="24" Foreground="#FFFFD27A" FontWeight="Bold"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </ScrollViewer>


        <Button Grid.Row="2" Height="45" Width="200" HorizontalAlignment="Center" VerticalAlignment="Center" Click="BackToMenu_Click" FontSize="25">
            </Button>
    </Grid>
</Page>
