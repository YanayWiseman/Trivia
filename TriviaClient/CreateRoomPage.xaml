<Page x:Class="TriviaClient.CreateRoomPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:userControls="clr-namespace:TriviaClient.View.UserControls"
      mc:Ignorable="d"
      d:DesignHeight="450"
      d:DesignWidth="800"
      Title="CreateRoomPage">

    <Grid Background="#FF4100">

        <Button Height="30" Width="80" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,25,25,0" FontFamily="Permanent Marker" Click="GoBack_Click" Content="Go Back"/>

        <Border Width="380" Padding="30" Background="Orange" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>

                <TextBlock Text="Create Room" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" FontFamily="Permanent Marker" Margin="0,0,0,30"/>

                <TextBlock Text="Room Name" FontSize="14" FontFamily="Permanent Marker" Margin="0,0,0,5"/>
                <userControls:ClearableTextBox x:Name="RoomNameTextBox" Width="250" Height="40" PlaceHolder="room name..."/>

                <TextBlock Text="Time Per Question" FontSize="14" FontFamily="Permanent Marker" Margin="0,15,0,5"/>
                <userControls:ClearableTextBox x:Name="QuestionTimeTextBox" Width="250" Height="40" PlaceHolder="time in seconds..."/>

                <TextBlock Text="Max Players" FontSize="14" FontFamily="Permanent Marker" Margin="0,15,0,5"/>
                <userControls:ClearableTextBox x:Name="MaxPlayersTextBox" Width="250" Height="40" PlaceHolder="max players..."/>

                <Button Content="Create Room" Height="45" FontSize="18" FontFamily="Permanent Marker" Margin="0,25,0,0" Click="CreateRoom_Click"/>

            </StackPanel>
        </Border>

    </Grid>
</Page>