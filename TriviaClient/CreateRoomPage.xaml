<Page x:Class="TriviaClient.CreateRoomPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="450"
      d:DesignWidth="800"
      Title="CreateRoomPage"
      Background="Transparent">

    <Page.Resources>
        <Style x:Key="LocalCyberTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#E50D080B"/>
            <Setter Property="Foreground" Value="#FFFFF4D6"/>
            <Setter Property="CaretBrush" Value="#FFFFBF32"/>
            <Setter Property="BorderBrush" Value="#A8FFBF32"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="TextBoxBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                                <TextBlock x:Name="PlaceholderText"
                                           Text="{TemplateBinding Tag}"
                                           Margin="11,0"
                                           FontFamily="Consolas"
                                           FontSize="14"
                                           Foreground="#88FFD27A"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Text" Value=""/>
                                    <Condition Property="IsKeyboardFocused" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible"/>
                            </MultiTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="PlaceholderText" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="TextBoxBorder" Property="BorderBrush" Value="#FFFFBF32"/>
                                <Setter TargetName="TextBoxBorder" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TextBoxBorder" Property="Background" Value="#F0150C18"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="Transparent">
        <Button Height="40" Width="110" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,25,25,0" Click="GoBack_Click" Content="GO BACK"/>

        <Border Width="380" Padding="30" Background="#DC160E17" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#B8FFBF32" BorderThickness="1.5">
            <StackPanel>
                <TextBlock Text="Create Room" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                <TextBlock Text="Room Name" FontSize="14" Margin="0,0,0,5"/>
                <TextBox x:Name="RoomNameTextBox" Width="250" Height="40"/>

                <TextBlock Text="Time Per Question (seconds)" FontSize="14" Margin="0,15,0,5"/>
                <TextBox x:Name="QuestionTimeTextBox" Width="250" Height="40"/>

                <TextBlock Text="Max Players" FontSize="14" Margin="0,15,0,5"/>
                <TextBox x:Name="MaxPlayersTextBox" Width="250" Height="40"/>

                <Button Content="Create Room" Height="45" FontSize="18" Margin="0,25,0,0" Click="CreateRoom_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
