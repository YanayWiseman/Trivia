<Page x:Class="TriviaClient.CreateRoomPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="CreateRoomPage"
      Background="Transparent">

    <Page.Resources>
        <Style x:Key="CreateRoomTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#FFFFF2C7"/>
            <Setter Property="CaretBrush" Value="#FFFFBF32"/>
            <Setter Property="Background" Value="#F20A060C"/>
            <Setter Property="BorderBrush" Value="#B8FFBF32"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SelectionBrush" Value="#FFC81D2A"/>
            <Setter Property="SelectionTextBrush" Value="White"/>

            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#FFFFD64A"/>
                    <Setter Property="Background" Value="#FF130B16"/>
                </Trigger>

                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#FFFFD64A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FFFFD36A"/>
            <Setter Property="Margin" Value="3,0,0,4"/>
        </Style>
    </Page.Resources>

    <Grid Margin="24">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <Border Width="430"
                    Padding="36,24"
                    Margin="0,38,0,14"
                    HorizontalAlignment="Center"
                    Background="#E8160E17"
                    BorderBrush="#C8FFBF32"
                    BorderThickness="1.5"
                    CornerRadius="10">

                <StackPanel>
                    <TextBlock Text="CREATE ROOM"
                               FontSize="31"
                               FontWeight="Black"
                               Foreground="#FFFFF2C7"
                               TextAlignment="Center"/>

                    <TextBlock Text="INITIALIZE NEW SESSION"
                               FontFamily="Consolas"
                               FontSize="12"
                               Foreground="#FFFFBF32"
                               TextAlignment="Center"
                               Margin="0,4,0,20"/>

                    <TextBlock Text="ROOM NAME"
                               Style="{StaticResource FieldLabelStyle}"/>

                    <TextBox x:Name="RoomNameTextBox"
                             Style="{StaticResource CreateRoomTextBoxStyle}"
                             Margin="0,0,0,12"/>

                    <TextBlock Text="TIME PER QUESTION"
                               Style="{StaticResource FieldLabelStyle}"/>

                    <TextBox x:Name="QuestionTimeTextBox"
                             Style="{StaticResource CreateRoomTextBoxStyle}"
                             Margin="0,0,0,12"/>

                    <TextBlock Text="MAX PLAYERS"
                               Style="{StaticResource FieldLabelStyle}"/>

                    <TextBox x:Name="MaxPlayersTextBox"
                             Style="{StaticResource CreateRoomTextBoxStyle}"
                             Margin="0,0,0,12"/>

                    <TextBlock Text="NUMBER OF QUESTIONS (1-20)"
                               Style="{StaticResource FieldLabelStyle}"/>

                    <TextBox x:Name="QuestionsCountTextBox"
                             Style="{StaticResource CreateRoomTextBoxStyle}"
                             Text="10"
                             Margin="0,0,0,20"/>

                    <Button Content="CREATE ROOM"
                            Height="46"
                            FontSize="16"
                            Click="CreateRoom_Click"/>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <Button Content="BACK"
                Width="105"
                Height="40"
                Padding="8,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Click="GoBack_Click"/>
    </Grid>
</Page>