<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="TriviaClient.OneVsOneCountdownPage" Title="OneVsOneCountdownPage" Background="Transparent">

    <Grid Background="Transparent">
        <Border Width="420" Height="300" Padding="30" Background="#DC160E17" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#B8FFBF32" BorderThickness="1.5">

            <StackPanel VerticalAlignment="Center">

                <TextBlock Text="Match Found!" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <TextBlock x:Name="opponentTextBlock" FontSize="22" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                <TextBlock Text="Game starts in:" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                <TextBlock x:Name="countdownTextBlock" FontSize="54" FontWeight="Bold" HorizontalAlignment="Center"/>

            </StackPanel>
        </Border>
    </Grid>
</Page>
