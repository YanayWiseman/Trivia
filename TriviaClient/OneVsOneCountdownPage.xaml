<Page x:Class="TriviaClient.OneVsOneCountdownPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="OneVsOneCountdownPage">

    <Grid Background="#FF4100">
        <Border Width="420"
                Height="300"
                Padding="30"
                Background="Orange"
                CornerRadius="12"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel VerticalAlignment="Center">

                <TextBlock Text="Match Found!"
                           FontSize="32"
                           FontWeight="Bold"
                           FontFamily="Permanent Marker"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <TextBlock x:Name="opponentTextBlock"
                           FontSize="22"
                           FontFamily="Permanent Marker"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,25"/>

                <TextBlock Text="Game starts in:"
                           FontSize="20"
                           FontFamily="Permanent Marker"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>

                <TextBlock x:Name="countdownTextBlock"
                           FontSize="54"
                           FontWeight="Bold"
                           FontFamily="Permanent Marker"
                           HorizontalAlignment="Center"/>

            </StackPanel>
        </Border>
    </Grid>
</Page>